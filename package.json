    "postcss-pxtorem": "^6.1.0",
    "prismjs": "^1.30.0",
    "query-string": "^8.0.3",
    "sortablejs": "^1.15.0",
    "three": "^0.181.2",
    "tslint": "^6.1.3",
    "vue": "^3.2.40",
    "vue-echarts": "^6.2.3",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.0.14",
    "vuedraggable": "^4.1.0"
